 
    // Dibujar cada tipo con sus propios vectores detallados
    if (f.type === 0) {
      // 🌿 Hierba Silvestre (Green sprout)
      // Tallo
      ctx.strokeStyle = '#2d6a4f';
      ctx.lineWidth = 3;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(px, yBob + 8);
      ctx.quadraticCurveTo(px - 2, yBob, px - 1, yBob - 6);
      ctx.stroke();

      // Hoja Izquierda
      ctx.fillStyle = '#52b788';
      ctx.beginPath();
      ctx.moveTo(px - 1, yBob - 2);
      ctx.quadraticCurveTo(px - 12, yBob - 8, px - 10, yBob + 2);
      ctx.quadraticCurveTo(px - 4, yBob + 4, px - 1, yBob - 2);
      ctx.fill();
      ctx.strokeStyle = '#1b4332';
      ctx.lineWidth = 1;
      ctx.stroke();

      // Hoja Derecha
      ctx.fillStyle = '#74c69d';
      ctx.beginPath();
      ctx.moveTo(px - 1, yBob - 4);
      ctx.quadraticCurveTo(px + 10, yBob - 10, px + 9, yBob - 1);
      ctx.quadraticCurveTo(px + 4, yBob + 2, px - 1, yBob - 4);
      ctx.fill();
      ctx.strokeStyle = '#1b4332';
      ctx.lineWidth = 1;
      ctx.stroke();

    } else if (f.type === 1) {
      // 🥦 Brócoli Fresco (Broccoli)
      // Tallo/Tronco
      ctx.fillStyle = '#a7c957';
      ctx.strokeStyle = '#386641';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(px - 4, yBob + 9);
      ctx.lineTo(px - 3, yBob + 1);
      ctx.lineTo(px + 3, yBob + 1);
      ctx.lineTo(px + 4, yBob + 9);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      // Cabezas/Ramilletes (cúpula de círculos superpuestos)
      ctx.fillStyle = '#386641';
      ctx.beginPath();
      ctx.arc(px, yBob - 3, 7, 0, Math.PI * 2);
      ctx.arc(px - 5, yBob - 1, 6, 0, Math.PI * 2);
      ctx.arc(px + 5, yBob - 1, 6, 0, Math.PI * 2);
      ctx.arc(px - 3, yBob - 6, 5, 0, Math.PI * 2);
      ctx.arc(px + 3, yBob - 6, 5, 0, Math.PI * 2);
      ctx.fill();

      // Delinear silueta exterior superior
      ctx.strokeStyle = '#1b4332';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(px - 5, yBob - 1, 6, Math.PI * 0.7, Math.PI * 1.6);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(px - 3, yBob - 6, 5, Math.PI * 1.0, Math.PI * 1.7);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(px + 3, yBob - 6, 5, Math.PI * 1.3, Math.PI * 2.0);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(px + 5, yBob - 1, 6, -Math.PI * 0.6, Math.PI * 0.3);
      ctx.stroke();

      // Pequeños puntitos de textura
      ctx.fillStyle = '#6a994e';
      ctx.fillRect(px - 3, yBob - 2, 1.2, 1.2);
      ctx.fillRect(px + 2, yBob - 4, 1.2, 1.2);
      ctx.fillRect(px, yBob - 7, 1.2, 1.2);

    } else if (f.type === 2) {
      // 🥬 Col Crujiente (Cabbage)
      // Hojas exteriores (izquierda y derecha)
      ctx.fillStyle = '#52b788';
      ctx.strokeStyle = '#1b4332';
      ctx.lineWidth = 1.5;
      
      // Hoja exterior izquierda
      ctx.beginPath();
      ctx.arc(px - 3, yBob + 1, 8, Math.PI * 0.5, Math.PI * 1.7);
      ctx.quadraticCurveTo(px - 2, yBob - 3, px, yBob + 1);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      // Hoja exterior derecha
      ctx.beginPath();
      ctx.arc(px + 3, yBob + 1, 8, -Math.PI * 0.7, Math.PI * 0.5);
      ctx.quadraticCurveTo(px + 2, yBob - 3, px, yBob + 1);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      // Corazón central más claro
      ctx.fillStyle = '#b7e4c7';
      ctx.beginPath();
      ctx.arc(px, yBob + 2, 6, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      // Nervaduras interiores
      ctx.strokeStyle = '#d8f3dc';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(px - 1, yBob + 2, 4.5, Math.PI * 0.6, Math.PI * 1.5);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(px + 1, yBob + 2, 4.5, -Math.PI * 0.5, Math.PI * 0.4);
      ctx.stroke();

    } else if (f.type === 3) {
      // 🍎 Manzana Roja (Apple)
      // Cuerpo
      ctx.fillStyle = '#e53935';
      ctx.beginPath();
      ctx.arc(px - 4, yBob + 1, 8.5, 0, Math.PI * 2);
      ctx.arc(px + 4, yBob + 1, 8.5, 0, Math.PI * 2);
      ctx.fill();

      // Borde
      ctx.strokeStyle = '#b71c1c';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(px - 4, yBob + 1, 8.5, 0.3, Math.PI * 1.8);
      ctx.arc(px + 4, yBob + 1, 8.5, -Math.PI * 0.8, Math.PI * 0.7);
      ctx.stroke();

      // Tallo
      ctx.strokeStyle = '#5d4037';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(px, yBob - 5);
      ctx.quadraticCurveTo(px + 2, yBob - 10, px + 5, yBob - 12);
      ctx.stroke();

      // Hoja
      ctx.fillStyle = '#4caf50';
      ctx.beginPath();
      ctx.ellipse(px + 3.5, yBob - 9, 3.5, 1.8, -Math.PI / 4, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#1b5e20';
      ctx.lineWidth = 0.8;
      ctx.stroke();

      // Brillo
      ctx.fillStyle = 'rgba(255,255,255,0.4)';
      ctx.beginPath();
      ctx.arc(px - 4, yBob - 2, 2.5, 0, Math.PI * 2);
      ctx.fill();

    } else {
      // 🍊 Naranja Dulce (Orange)
      // Cuerpo
      ctx.fillStyle = '#ff9800';
      ctx.beginPath();
      ctx.arc(px, yBob + 1, 9.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#e65100';
      ctx.lineWidth = 1.5;
      ctx.stroke();

      // Textura (puntitos)
      ctx.fillStyle = '#f57c00';
      ctx.fillRect(px - 3, yBob + 2, 1.5, 1.5);
      ctx.fillRect(px + 4, yBob - 2, 1.5, 1.5);

      // Tallo y hoja
      ctx.fillStyle = '#5d4037';
      ctx.fillRect(px - 1, yBob - 9, 2, 2);

      ctx.fillStyle = '#4caf50';
      ctx.beginPath();
      ctx.ellipse(px - 2, yBob - 9.5, 3.5, 1.8, Math.PI / 6, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#1b5e20';
      ctx.lineWidth = 0.8;
      ctx.stroke();

      // Brillo
      ctx.fillStyle = 'rgba(255,255,255,0.4)';
      ctx.beginPath();
      ctx.arc(px - 3, yBob - 2, 2.5, 0, Math.PI * 2);
      ctx.fill();
    }

    ctx.restore();

    // Puntos de brillo estrella (animados)
    const sa = t * 0.05 + f.anim;
    ctx.strokeStyle = 'rgba(255,255,255,0.8)';
    ctx.lineWidth = 1;
    for (let i = 0; i < 4; i++) {
      const angle = sa + i * Math.PI / 2;
      const r1 = TILE * 0.32, r2 = TILE * 0.42;
      ctx.beginPath();
      ctx.moveTo(px + Math.cos(angle)*r1, yBob + Math.sin(angle)*r1);
      ctx.lineTo(px + Math.cos(angle)*r2, yBob + Math.sin(angle)*r2);
      ctx.stroke();
    }
  }
}
